#!/usr/sbin/nft -f
# ORION V3 : le compte orion-v3 ne joint jamais les services de la V2 (docs/v3/environnements.md, audit).
# Copié dans /etc/orion-v3/isolation.nft (deploy/v3_reference_root.sh) et rechargé à chaque démarrage d'orion-v3
# (ExecStartPre) : sans ces règles, le service ne démarre pas.
#
# - Core V2 sur le mini-PC : 8765 visage, 8766 API, 8767 fond d'écran (il autorise toujours 127.0.0.1), 8770
#   passerelle d'appel ; par la boucle locale comme par l'adresse du réseau.
# - Anciens agents V2 : PC fixe et Katana (8765).
# Restent permis : Ollama (11434, mini-PC et Katana), SearXNG (8080), Internet (flux d'actualités), ses propres ports
# 8865-8867, l'agent Windows V3 du PC (8875, son propre jeton) et la transcription du Katana (8766, jeton de la V3 :
# service partagé, la V3 est le Core actif depuis le 4 novembre 2026).

table inet orion_v3_isolation
delete table inet orion_v3_isolation

table inet orion_v3_isolation {
	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid "orion-v3" ip daddr { 127.0.0.0/8, 192.168.1.91 } tcp dport { 8765, 8766, 8767, 8770 } counter reject with tcp reset
		meta skuid "orion-v3" ip6 daddr ::1 tcp dport { 8765, 8766, 8767, 8770 } counter reject with tcp reset
		meta skuid "orion-v3" ip daddr { 192.168.1.128, 192.168.1.73 } tcp dport 8765 counter reject with tcp reset
		meta skuid "orion-v3" ip daddr 192.168.1.128 tcp dport 8766 counter reject with tcp reset
	}
}
