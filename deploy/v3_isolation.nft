#!/usr/sbin/nft -f
# ORION V3 : le compte orion-v3 ne joint jamais les services de la production (docs/v3/environnements.md, audit).
# Rechargé à chaque démarrage d'orion-v3 (ExecStartPre) : sans ces règles, le service ne démarre pas.
#
# - Production sur le mini-PC : 8765 visage, 8766 API, 8767 fond d'écran (il autorise toujours 127.0.0.1), 8770
#   passerelle d'appel ; par la boucle locale comme par l'adresse du réseau.
# - Agents de la production : PC fixe et Katana (8765), transcription du Katana (8766).
# Restent permis : Ollama (11434), SearXNG (8080), Internet (flux d'actualités), ses propres ports 8865-8867.

table inet orion_v3_isolation
delete table inet orion_v3_isolation

table inet orion_v3_isolation {
	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid "orion-v3" ip daddr { 127.0.0.0/8, 192.168.1.91 } tcp dport { 8765, 8766, 8767, 8770 } counter reject with tcp reset
		meta skuid "orion-v3" ip6 daddr ::1 tcp dport { 8765, 8766, 8767, 8770 } counter reject with tcp reset
		meta skuid "orion-v3" ip daddr { 192.168.1.128, 192.168.1.73 } tcp dport { 8765, 8766 } counter reject with tcp reset
	}
}
