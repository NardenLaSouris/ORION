# Copier ce fichier en .env (jamais versionné) et y mettre votre jeton Hugging Face
# (lecture seule), nécessaire au premier téléchargement des modèles NeuTTS.
HF_TOKEN=

# Jeton partagé entre le Core JARVIS et l'agent Windows (32 caractères minimum), identique des deux côtés.
ORION_AGENT_TOKEN=

# Agent Windows du PC qui héberge Frag Factory : jeton de liaison (32 caractères minimum), identique à
# ORION_LINK_TOKEN dans Frag Factory (Paramètres → Clés API). Seulement si [fragfactory] est activé dans windows_agent.toml.
FRAGFACTORY_LINK_TOKEN=
